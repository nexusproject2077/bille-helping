rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Collection des profils utilisateurs
    match /users/{userId} {

      // Lecture : uniquement si connecte.
      // (Plus tard on restreindra davantage, ex. ne pas exposer la date de naissance exacte.)
      allow read: if request.auth != null;

      // Creation : uniquement par le proprietaire du compte,
      // et on impose les regles de conformite des le serveur.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.consent.age18 == true
                    && request.resource.data.consent.dataProcessing == true
                    && request.resource.data.identityVerified == false;

      // Mise a jour : uniquement par le proprietaire.
      allow update: if request.auth != null
                    && request.auth.uid == userId;

      // Suppression : uniquement par le proprietaire (droit a l'effacement RGPD).
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Tout le reste est interdit par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
