rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Profils utilisateurs =====
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.consent.age18 == true
                    && request.resource.data.consent.dataProcessing == true
                    && request.resource.data.consent.adultContent == true
                    && request.resource.data.identityVerified == false;

      // Mise a jour de son propre profil, MAIS l'utilisateur ne peut jamais
      // MODIFIER lui-meme les champs sensibles pilotes par le serveur :
      //  - identityVerified (badge verifie : validation admin / KYC uniquement)
      //  - blocked (liste de blocage : geree par le backend via /api/report)
      // On interdit uniquement le changement de ces cles (robuste aux MAJ
      // partielles et aux documents anciens qui ne les possedent pas encore).
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['identityVerified', 'blocked']);
      // La suppression de compte passe par le backend (Admin SDK) : interdite cote client.
      allow delete: if false;

      // Sous-collection des swipes (like/pass) : prives au proprietaire,
      // MAIS lisibles par autrui uniquement pour verifier un match mutuel.
      match /swipes/{targetId} {
        // Le proprietaire gere ses propres swipes
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Autrui peut lire UNIQUEMENT le swipe qui le concerne (pour detecter le match)
        allow read: if request.auth != null && request.auth.uid == targetId;
      }

      // Notifications de moderation : ecrites par le backend (Admin SDK).
      // Le proprietaire peut les lire et seulement basculer le champ "read".
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ===== Matchs =====
    match /matches/{matchId} {
      // Lecture / creation / maj : uniquement si on fait partie du match
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users;
      // Mise a jour possible par un participant, mais la liste des participants
      // ne peut pas etre modifiee (pas de detournement de conversation).
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.users
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users']);
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.users;

      // ===== Messages du match =====
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        // Un message est soit du texte (1-500), soit un media (image/video + URL).
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.from
                      && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users
                      && (
                        (request.resource.data.text is string
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 500)
                        || (request.resource.data.type in ['image', 'video']
                          && request.resource.data.mediaUrl is string)
                        || (request.resource.data.type in ['place', 'place_reply'])
                      );
        // Update : autorise pour marquer comme lu (uniquement le destinataire, pas l'expediteur)
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users
                      && request.auth.uid != resource.data.from;
      }
    }

    // ===== Signalements =====
    match /reports/{reportId} {
      // Les signalements sont crees par le backend (Admin SDK), jamais
      // directement par le client : tout acces cote client est interdit.
      allow read, create, update, delete: if false;
    }

    // Tout le reste interdit par defaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
