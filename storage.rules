rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos de profil : dossier users/{uid}/
    match /users/{userId}/{fileName} {

      // Lecture : tout membre connecte (pour voir les photos dans Decouvrir/Messages)
      allow read: if request.auth != null;

      // Ecriture : uniquement le proprietaire, images uniquement, max 5 Mo
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Suppression : uniquement le proprietaire
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
