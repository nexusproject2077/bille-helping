rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos de profil : dossier users/{uid}/
    match /users/{userId}/{fileName} {

      // Lecture : tout membre connecte (pour voir les photos dans Decouvrir/Messages)
      allow read: if request.auth != null;

      // Ecriture : uniquement le proprietaire, images uniquement, max 5 Mo
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Suppression : uniquement le proprietaire
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== Medias de conversation : dossier matches/{matchId}/ =====
    // Reserves aux DEUX participants du match (verifie via Firestore).
    match /matches/{matchId}/{fileName} {
      function participant() {
        return request.auth != null
          && request.auth.uid in firestore.get(/databases/(default)/documents/matches/$(matchId)).data.users;
      }
      allow read: if participant();
      // Image < 8 Mo OU video < 30 Mo
      allow write: if participant()
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 30 * 1024 * 1024)
        );
      allow delete: if participant();
    }
  }
}
